# ------------------------------------------------------------------
# ClaudeSounds — example environment file
# Copy to `.env` and replace every placeholder with real values.
# Never commit your real `.env` file.
# ------------------------------------------------------------------

# ---- Server ----
# Port the Express API binds to (assigned by the deploy script).
PORT=4107

# Node environment: development | production
NODE_ENV=production

# ---- MySQL database ----
# Hostname of the MySQL server.
DB_HOST=localhost

# MySQL user with access to the ClaudeSounds schema.
DB_USER=claudesounds_user

# MySQL password for the user above.
DB_PASSWORD=change_me_database_password

# Database/schema name (import schema.sql into this database).
DB_NAME=claudesounds

# ---- Sessions ----
# Long random string used to sign the session cookie.
SESSION_SECRET=change_me_to_a_long_random_string

# Cookie domain so the session is shared across *.arx-app.com subdomains.
SESSION_COOKIE_DOMAIN=.arx-app.com

# ---- TLS (terminate HTTPS directly in the Express process) ----
# Set to 'true' to serve the API over HTTPS using the certs below.
SSL_ENABLED=true

# Absolute path to the TLS certificate file.
SSL_CERT_PATH=/home/arx-app/backends/certs/certificate.crt

# Absolute path to the TLS private key file.
SSL_KEY_PATH=/home/arx-app/backends/certs/private.key

# Optional absolute path to a CA chain file (leave blank if unused).
SSL_CA_PATH=

# ---- Frontend ----
# Public base URL of the ClaudeSounds API used by the browser.
NEXT_PUBLIC_API_URL=https://claudesounds-api.arx-app.com:4107