-- ============================================================================
-- ClaudeSounds — MySQL 8 schema
-- Music distribution, publishing & marketing platform
--
-- Import with:
--   mysql -h $DB_HOST -u $DB_USER -p $DB_NAME < schema.sql
--
-- Character set: utf8mb4 / utf8mb4_unicode_ci everywhere.
-- ============================================================================

SET NAMES utf8mb4;
SET FOREIGN_KEY_CHECKS = 0;

-- ----------------------------------------------------------------------------
-- Drop in dependency-safe order (re-runnable script)
-- ----------------------------------------------------------------------------
DROP TABLE IF EXISTS royalty_statements;
DROP TABLE IF EXISTS stream_stats;
DROP TABLE IF EXISTS streams;
DROP TABLE IF EXISTS campaigns;
DROP TABLE IF EXISTS publishing_splits;
DROP TABLE IF EXISTS publishing_works;
DROP TABLE IF EXISTS works;
DROP TABLE IF EXISTS store_deliveries;
DROP TABLE IF EXISTS release_stores;
DROP TABLE IF EXISTS tracks;
DROP TABLE IF EXISTS releases;
DROP TABLE IF EXISTS sessions;
DROP TABLE IF EXISTS users;

SET FOREIGN_KEY_CHECKS = 1;

-- ----------------------------------------------------------------------------
-- users
-- ----------------------------------------------------------------------------
CREATE TABLE users (
  id            INT UNSIGNED NOT NULL AUTO_INCREMENT,
  email         VARCHAR(190) NOT NULL,
  password_hash VARCHAR(255) NOT NULL,
  display_name  VARCHAR(120) NOT NULL,
  artist_name   VARCHAR(120) NOT NULL,
  role          ENUM('artist','label','admin') NOT NULL DEFAULT 'artist',
  created_at    TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
  PRIMARY KEY (id),
  UNIQUE KEY uq_users_email (email),
  KEY idx_users_role (role)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- ----------------------------------------------------------------------------
-- sessions (express-mysql-session compatible)
-- ----------------------------------------------------------------------------
CREATE TABLE sessions (
  session_id VARCHAR(128) NOT NULL,
  expires    INT UNSIGNED NOT NULL,
  data       MEDIUMTEXT COLLATE utf8mb4_bin,
  PRIMARY KEY (session_id),
  KEY idx_sessions_expires (expires)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_bin;

-- ----------------------------------------------------------------------------
-- releases
-- ----------------------------------------------------------------------------
CREATE TABLE releases (
  id            INT UNSIGNED NOT NULL AUTO_INCREMENT,
  user_id       INT UNSIGNED NOT NULL,
  title         VARCHAR(200) NOT NULL,
  artist_name   VARCHAR(160) NOT NULL,
  release_type  ENUM('single','ep','album') NOT NULL DEFAULT 'single',
  primary_genre VARCHAR(80) NOT NULL DEFAULT 'Pop',
  genre         VARCHAR(100) DEFAULT NULL,
  label         VARCHAR(160) DEFAULT NULL,
  upc           VARCHAR(32) DEFAULT NULL,
  release_date  DATE DEFAULT NULL,
  status        ENUM('draft','in_review','approved','live','takedown') NOT NULL DEFAULT 'draft',
  artwork_color VARCHAR(16) NOT NULL DEFAULT 'amber',
  created_at    TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
  updated_at    TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  PRIMARY KEY (id),
  KEY idx_releases_user (user_id),
  KEY idx_releases_status (status),
  KEY idx_releases_date (release_date),
  CONSTRAINT fk_releases_user FOREIGN KEY (user_id) REFERENCES users (id) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- ----------------------------------------------------------------------------
-- tracks
-- ----------------------------------------------------------------------------
CREATE TABLE tracks (
  id               INT UNSIGNED NOT NULL AUTO_INCREMENT,
  release_id       INT UNSIGNED NOT NULL,
  track_number     SMALLINT UNSIGNED NOT NULL DEFAULT 1,
  title            VARCHAR(200) NOT NULL,
  isrc             VARCHAR(24) DEFAULT NULL,
  duration_seconds INT UNSIGNED NOT NULL DEFAULT 0,
  explicit         TINYINT(1) NOT NULL DEFAULT 0,
  songwriters      TEXT,
  PRIMARY KEY (id),
  KEY idx_tracks_release (release_id),
  KEY idx_tracks_isrc (isrc),
  CONSTRAINT fk_tracks_release FOREIGN KEY (release_id) REFERENCES releases (id) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- ----------------------------------------------------------------------------
-- store_deliveries
-- ----------------------------------------------------------------------------
CREATE TABLE store_deliveries (
  id           INT UNSIGNED NOT NULL AUTO_INCREMENT,
  release_id   INT UNSIGNED NOT NULL,
  store_name   VARCHAR(80) NOT NULL,
  status       ENUM('pending','delivered','live','failed') NOT NULL DEFAULT 'pending',
  delivered_at DATETIME DEFAULT NULL,
  PRIMARY KEY (id),
  KEY idx_deliveries_release (release_id),
  KEY idx_deliveries_status (status),
  CONSTRAINT fk_deliveries_release FOREIGN KEY (release_id) REFERENCES releases (id) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- ----------------------------------------------------------------------------
-- release_stores
-- ----------------------------------------------------------------------------
CREATE TABLE release_stores (
  id           INT UNSIGNED NOT NULL AUTO_INCREMENT,
  release_id   INT UNSIGNED NOT NULL,
  store_name   VARCHAR(80) NOT NULL,
  delivered    TINYINT(1) NOT NULL DEFAULT 0,
  delivered_at DATETIME DEFAULT NULL,
  PRIMARY KEY (id),
  KEY idx_release_stores_release (release_id),
  CONSTRAINT fk_release_stores_release FOREIGN KEY (release_id) REFERENCES releases (id) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- ----------------------------------------------------------------------------
-- publishing_works
-- ----------------------------------------------------------------------------
CREATE TABLE publishing_works (
  id                  INT UNSIGNED NOT NULL AUTO_INCREMENT,
  user_id             INT UNSIGNED NOT NULL,
  track_id            INT UNSIGNED DEFAULT NULL,
  work_title          VARCHAR(200) NOT NULL,
  iswc                VARCHAR(24) DEFAULT NULL,
  society             VARCHAR(60) DEFAULT NULL,
  registration_status ENUM('unregistered','submitted','registered') NOT NULL DEFAULT 'unregistered',
  created_at          TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
  PRIMARY KEY (id),
  KEY idx_works_user (user_id),
  KEY idx_works_track (track_id),
  KEY idx_works_status (registration_status),
  CONSTRAINT fk_works_user FOREIGN KEY (user_id) REFERENCES users (id) ON DELETE CASCADE,
  CONSTRAINT fk_works_track FOREIGN KEY (track_id) REFERENCES tracks (id) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- ----------------------------------------------------------------------------
-- works (alternative publishing table)
-- ----------------------------------------------------------------------------
CREATE TABLE works (
  id                  INT UNSIGNED NOT NULL AUTO_INCREMENT,
  user_id             INT UNSIGNED NOT NULL,
  title               VARCHAR(255) NOT NULL,
  iswc                VARCHAR(32) DEFAULT NULL,
  writers             VARCHAR(500) NOT NULL,
  publisher           VARCHAR(255) DEFAULT NULL,
  split_percent       DECIMAL(5,2) DEFAULT NULL,
  registration_status ENUM('pending','registered','rejected') NOT NULL DEFAULT 'pending',
  created_at          TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
  PRIMARY KEY (id),
  KEY idx_works_user_id (user_id),
  KEY idx_works_registration_status (registration_status),
  CONSTRAINT fk_works_user_id FOREIGN KEY (user_id) REFERENCES users (id) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- ----------------------------------------------------------------------------
-- publishing_splits
-- ----------------------------------------------------------------------------
CREATE TABLE publishing_splits (
  id            INT UNSIGNED NOT NULL AUTO_INCREMENT,
  work_id       INT UNSIGNED NOT NULL,
  writer_name   VARCHAR(160) NOT NULL,
  role          ENUM('composer','lyricist','arranger','publisher') NOT NULL DEFAULT 'composer',
  share_percent DECIMAL(5,2) NOT NULL DEFAULT 0.00,
  PRIMARY KEY (id),
  KEY idx_splits_work (work_id),
  CONSTRAINT fk_splits_work FOREIGN KEY (work_id) REFERENCES publishing_works (id) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- ----------------------------------------------------------------------------
-- campaigns
-- ----------------------------------------------------------------------------
CREATE TABLE campaigns (
  id           INT UNSIGNED NOT NULL AUTO_INCREMENT,
  user_id      INT UNSIGNED NOT NULL,
  release_id   INT UNSIGNED DEFAULT NULL,
  name         VARCHAR(200) NOT NULL,
  channel      ENUM('playlist_pitch','social_ads','pr','email','influencer','playlist','social','ads') NOT NULL DEFAULT 'playlist_pitch',
  status       ENUM('draft','scheduled','running','completed','paused','planned','active') NOT NULL DEFAULT 'draft',
  budget_cents INT NOT NULL DEFAULT 0,
  spend_cents  INT NOT NULL DEFAULT 0,
  budget       DECIMAL(10,2) NOT NULL DEFAULT 0.00,
  spend        DECIMAL(10,2) NOT NULL DEFAULT 0.00,
  start_date   DATE DEFAULT NULL,
  end_date     DATE DEFAULT NULL,
  clicks       INT NOT NULL DEFAULT 0,
  impressions  INT NOT NULL DEFAULT 0,
  created_at   TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
  PRIMARY KEY (id),
  KEY idx_campaigns_user (user_id),
  KEY idx_campaigns_release (release_id),
  KEY idx_campaigns_status (status),
  CONSTRAINT fk_campaigns_user FOREIGN KEY (user_id) REFERENCES users (id) ON DELETE CASCADE,
  CONSTRAINT fk_campaigns_release FOREIGN KEY (release_id) REFERENCES releases (id) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- ----------------------------------------------------------------------------
-- stream_stats
-- ----------------------------------------------------------------------------
CREATE TABLE stream_stats (
  id           INT UNSIGNED NOT NULL AUTO_INCREMENT,
  release_id   INT UNSIGNED NOT NULL,
  stat_date    DATE NOT NULL,
  platform     VARCHAR(60) NOT NULL DEFAULT 'Spotify',
  streams      INT NOT NULL DEFAULT 0,
  listeners    INT NOT NULL DEFAULT 0,
  revenue_cents INT NOT NULL DEFAULT 0,
  PRIMARY KEY (id),
  KEY idx_stats_release_date (release_id, stat_date),
  KEY idx_stats_date (stat_date),
  KEY idx_stats_platform (platform),
  CONSTRAINT fk_stats_release FOREIGN KEY (release_id) REFERENCES releases (id) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- ----------------------------------------------------------------------------
-- streams (alternative analytics table)
-- ----------------------------------------------------------------------------
CREATE TABLE streams (
  id           INT UNSIGNED NOT NULL AUTO_INCREMENT,
  release_id   INT UNSIGNED NOT NULL,
  stream_date  DATE NOT NULL,
  store_name   VARCHAR(60) NOT NULL,
  stream_count INT NOT NULL DEFAULT 0,
  revenue      DECIMAL(10,2) NOT NULL DEFAULT 0.00,
  PRIMARY KEY (id),
  KEY idx_streams_release (release_id),
  KEY idx_streams_date (stream_date),
  KEY idx_streams_store (store_name),
  CONSTRAINT fk_streams_release FOREIGN KEY (release_id) REFERENCES releases (id) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

-- ----------------------------------------------------------------------------
-- royalty_statements
-- ----------------------------------------------------------------------------
CREATE TABLE royalty_statements (
  id           INT UNSIGNED NOT NULL AUTO_INCREMENT,
  user_id      INT UNSIGNED NOT NULL,
  period_label VARCHAR(60) NOT NULL,
  gross_cents  INT NOT NULL DEFAULT 0,
  fee_cents    INT NOT NULL DEFAULT 0,
  net_cents    INT NOT NULL DEFAULT 0,
  gross_amount DECIMAL(10,2) NOT NULL DEFAULT 0.00,
  fees_amount  DECIMAL(10,2) NOT NULL DEFAULT 0.00,
  net_amount   DECIMAL(10,2) NOT NULL DEFAULT 0.00,
  status       ENUM('pending','paid') NOT NULL DEFAULT 'pending',
  issued_at    DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
  paid_at      DATETIME DEFAULT NULL,
  PRIMARY KEY (id),
  KEY idx_royalties_user (user_id),
  KEY idx_royalties_status (status),
  KEY idx_royalties_issued (issued_at),
  CONSTRAINT fk_royalties_user FOREIGN KEY (user_id) REFERENCES users (id) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;

