-- ------------------------------------------------------------ stream_stats --
-- 60 days of daily per-platform stats for the two live releases, so the
-- dashboard can compare the last 30 days against the previous 30 days.
INSERT INTO stream_stats (release_id, stat_date, platform, streams, listeners, revenue_cents)
WITH RECURSIVE days (n) AS (
  SELECT 0
  UNION ALL
  SELECT n + 1 FROM days WHERE n < 59
),
platforms (platform, weight) AS (
  SELECT 'Spotify', 100 UNION ALL
  SELECT 'Apple Music', 52 UNION ALL
  SELECT 'Amazon Music', 28 UNION ALL
  SELECT 'YouTube Music', 34 UNION ALL
  SELECT 'Deezer', 14 UNION ALL
  SELECT 'Tidal', 8
),
rel (release_id, base) AS (
  SELECT 1, 42 UNION ALL
  SELECT 2, 70
)
SELECT
  rel.release_id,
  DATE_SUB(CURDATE(), INTERVAL days.n DAY) AS stat_date,
  platforms.platform,
  GREATEST(
    1,
    FLOOR(
      rel.base * platforms.weight / 100
      * (1 + (59 - days.n) * 0.012)
      * (1 + 0.18 * SIN(days.n / 3.0))
      + ((days.n * 37 + platforms.weight * 11 + rel.release_id * 7) % 23)
    )
  ) AS streams,
  GREATEST(
    1,
    FLOOR(
      rel.base * platforms.weight / 100
      * (1 + (59 - days.n) * 0.012)
      * (1 + 0.18 * SIN(days.n / 3.0))
      * 0.42
      + ((days.n * 13 + platforms.weight * 5 + rel.release_id * 3) % 11)
    )
  ) AS listeners,
  GREATEST(
    1,
    FLOOR(
      rel.base * platforms.weight / 100
      * (1 + (59 - days.n) * 0.012)
      * 0.38
    )
  ) AS revenue_cents
FROM days
CROSS JOIN platforms
CROSS JOIN rel;

-- A short tail of early data for the release that is still in review.
INSERT INTO stream_stats (release_id, stat_date, platform, streams, listeners, revenue_cents)
WITH RECURSIVE d (n) AS (
  SELECT 0 UNION ALL SELECT n + 1 FROM d WHERE n < 4
)
SELECT
  3,
  DATE_SUB(CURDATE(), INTERVAL d.n DAY),
  'Spotify',
  120 + (d.n * 37) % 60,
  60 + (d.n * 17) % 25,
  40 + (d.n * 7) % 20
FROM d;

